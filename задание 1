function hasTwoCubeSums(n) {
    let count = 0;
    const limit = Math.cbrt(n);

    for (let a = 1; a <= limit; a++) {
        let b3 = n - a ** 3;
        let b = Math.round(Math.cbrt(b3));
        
        if (b > a && b ** 3 === b3) {
            count++;
        }
    }

    return count >= 2;
}
